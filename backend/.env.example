# Conexão com o MongoDB (local ou MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017
DB_NAME=mortalidade_infantil

# Só necessário quando o frontend roda em outro endereço (ex.: yarn start na porta 3000)
CORS_ORIGINS=http://localhost:3000

# Com o banco vazio, carrega dados de demonstração na inicialização (true/false)
SEED_DEMO_DATA=true
